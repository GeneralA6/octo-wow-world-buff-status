# Copy to .env and fill in. Never commit .env.
#
# Use a DEDICATED throwaway Turtle account, never your main. A parked, always-online
# character is detectable, and Turtle's rules forbid automation — this account is the
# one you are willing to lose.

# --- Game account (a vanilla 1.12 server; defaults target OctoWoW) ---
WOW_ACCOUNT=YOURACCOUNT
WOW_PASSWORD=yourpassword

# Auth (logon) server = the "set realmlist" value from your client's realmlist.wtf.
# Port is almost always 3724. OctoWoW moved this to play.octowow.st (2026-08); the
# old octowow.st is being retired.
WOW_AUTH_HOST=play.octowow.st
WOW_AUTH_PORT=3724

# The realm to enter, exactly as it appears in the realm list (case-insensitive).
# OctoWoW has several — this must match the one your character is on.
WOW_REALM=N'Zoth

# The character on the account to log in (must already exist). It just parks in a city.
WOW_CHARACTER=YourBotChar

# Client-integrity checksum (StrictVersionCheck). OctoWoW rejects logins whose
# integrity proof is wrong. The default is the verified 1.12.1 value and works
# out of the box for OctoWoW. Set to "none" for servers without StrictVersionCheck,
# or a 40-hex-char value for a different client build.
# WOW_INTEGRITY_CHECKSUM=

# Client build advertised at logon. Defaults to OctoWoW's custom build 7272 (stock
# 1.12.1 is 5875). If OctoWoW ships a client patch that bumps the build, the bot
# auto-heals it (see WOW_AUTO_RESOLVE); set this only to pin a specific build.
# WOW_BUILD=

# Auto-heal across OctoWoW client patches. When a login is rejected for a wrong
# build, the bot reads the current build from the CDN copy of WoW.exe using a tiny
# 4-byte HTTP Range request (not the whole client) and retries. On by default; set
# to false/0/none to pin WOW_BUILD and never touch the network for it.
# WOW_AUTO_RESOLVE=true

# CDN base the auto-heal reads WoW.exe from. Defaults to OctoWoW's public client CDN.
# WOW_CLIENT_CDN=https://dl.octowow.st/client/latest

# Client build in the world auth session. OctoWoW's client sends stock 5875 here
# (not the logon build). Only change if a patch alters it.
# WOW_WORLD_BUILD=

# Optional: override the world server address if the realm-list address is unreachable
# (some servers advertise an internal address). Leave blank to use the realm list.
# WOW_WORLD_HOST=
# WOW_WORLD_PORT=

# --- What to watch ---
# Onyxia's Lair area id in 1.12 is 2159. Change to watch a different instance.
WATCH_AREA_ID=2159
WATCH_AREA_NAME=Onyxia's Lair

# How often to run /who, in seconds. Keep this gentle (>=15) to respect the server.
POLL_INTERVAL_SECONDS=20

# How many players a group must reach for a raid to count as "about to start".
# Default 15 (an OctoWoW Onyxia raid is ~20-25). One alert fires when a group first
# crosses this, and one when that same group has fully left the lair.
# WOW_MIN_RAID_SIZE=15

# How to tell several simultaneous raids apart. /who gives no instance id — just a
# flat list of everyone in the zone (capped at 49 names) — so the only field that
# separates concurrent raids is the guild tag.
#   auto  = (default) a guild that reaches the threshold is its own named raid;
#           everyone else — scattered guilds and the unguilded — pools into one
#           "pickup" cohort that forms its own raid. Catches guild raids AND pickups,
#           and a guild raid running next to a pickup one shows as two.
#   guild = every guild is its own raid; misses a pickup raid spread across guilds.
#   lair  = the whole lair is one raid (simplest; can't separate two at once).
# Note: two concurrent PICKUP raids still read as one — no /who field can split them.
# WOW_RAID_GROUPING=auto

# --- Alerts ---
# Discord channel webhook URL (Server Settings > Integrations > Webhooks).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# Optional: opt-in notifications. Create a self-assignable role (e.g. @OnyxiaWatch)
# and put its numeric id here. Raid enter/leave posts will ping ONLY that role, so
# only members who took the role get notified. Leave blank to just post silently to
# the channel. To get the id: Discord Developer Mode on, right-click the role >
# Copy Role ID.
DISCORD_MENTION_ROLE_ID=

# Post a "bot online" message to Discord on startup. Off by default to stay quiet —
# the bot restarts (redeploys, reconnects) shouldn't each announce themselves. Set
# to true/1 if you want a heartbeat on boot.
# WOW_ANNOUNCE_STARTUP=false

# Optional log level: debug | info | warn | error
LOG_LEVEL=info
