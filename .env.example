# Copy to .env and fill in. Never commit .env.
#
# Use a DEDICATED throwaway Turtle account, never your main. A parked, always-online
# character is detectable, and Turtle's rules forbid automation — this account is the
# one you are willing to lose.

# --- Turtle WoW account ---
WOW_ACCOUNT=YOURACCOUNT
WOW_PASSWORD=yourpassword

# Auth (logon) server. Turtle's realmlist host, port is almost always 3724.
WOW_AUTH_HOST=logon.turtle-wow.org
WOW_AUTH_PORT=3724

# The realm to enter, exactly as it appears in the realm list (case-insensitive match).
WOW_REALM=Turtle WoW

# The character on the account to log in (must already exist). It just parks in a city.
WOW_CHARACTER=YourBotChar

# Optional: override the world server address if the realm-list address is unreachable
# (some servers advertise an internal address). Leave blank to use the realm list.
# WOW_WORLD_HOST=
# WOW_WORLD_PORT=

# --- What to watch ---
# Onyxia's Lair area id in 1.12 is 2159. Change to watch a different instance.
WATCH_AREA_ID=2159
WATCH_AREA_NAME=Onyxia's Lair

# How often to run /who, in seconds. Keep this gentle (>=15) to respect the server.
POLL_INTERVAL_SECONDS=20

# --- Alerts ---
# Discord channel webhook URL (Server Settings > Integrations > Webhooks).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# Optional log level: debug | info | warn | error
LOG_LEVEL=info
